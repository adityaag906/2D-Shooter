                                                                                                                                                                                                        this.barrels.push({ x: c.x, y: c.y, radius: 22, hp: 35, maxHp: 35, exploded: false, flashTimer: 0 });
                                                                                                                                                                                                });

                                                                                                                                                                                                        this.spawnsBlue = [{ x: 250, y: 250 }, { x: 450, y: 250 }, { x: 250, y: 450 }];
                                                                                                                                                                                                        this.spawnsRed = [{ x: 2150, y: 2150 }, { x: 1950, y: 2150 }, { x: 2150, y: 1950 }];
