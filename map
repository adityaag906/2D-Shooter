/* CYBER STRIKE 2D - MAP ENGINE & ENVIRONMENT GENERATOR */

class GameMap {
        constructor(mapType = 'industrial') {
                this.type = mapType;
                this.width = 2400;
                this.height = 2400;
                this.tileSize = 60;
                this.walls = [];
                this.barrels = [];
                this.pickups = [];
                this.decals = []; // Persistent Blood Stains & Scorch Marks
                this.spawnsBlue = [];
                this.spawnsRed = [];
                this.spawnsFFA = [];

                this.generateMap(mapType);
        }

            generateMap(mapType) {
